{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker exec:*)",
      "Bash(docker inspect:*)",
      "Bash(docker image ls:*)",
      "Bash(docker image inspect:*)",
      "Bash(docker volume ls:*)",
      "Bash(docker network ls:*)",
      "Bash(docker network inspect:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(npm ls:*)",
      "Bash(./deploy/backup.sh:*)",
      "Bash(./deploy/restore.sh:*)",
      "Bash(./deploy/make-package.sh:*)",
      "Bash(ip -4 addr show:*)",
      "Bash(ip addr show:*)",
      "Bash(ip link show:*)",
      "Bash(ip route show:*)",
      "Bash(ip -o link show:*)",
      "Bash(ss -ltnp:*)",
      "Bash(ping:*)",
      "Bash(tailscale status:*)",
      "Bash(tailscale ip:*)",
      "Bash(curl:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(node -e:*)",
      "Edit(./**)",
      "Write(./**)"

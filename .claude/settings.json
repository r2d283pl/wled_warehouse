    "deny": [
      "Bash(ip link add:*)",
      "Bash(ip link set:*)",
      "Bash(ip link delete:*)",
      "Bash(ip link del:*)",
      "Bash(ip addr add:*)",
      "Bash(ip addr del:*)",
      "Bash(ip route add:*)",
      "Bash(ip route del:*)",
      "Bash(ip route replace:*)",
      "Bash(ip rule:*)",
      "Bash(sysctl:*)",
      "Bash(iptables:*)",
      "Bash(ip6tables:*)",
      "Bash(nft:*)",
      "Bash(ufw:*)",
      "Bash(firewall-cmd:*)",
      "Bash(tailscale up:*)",
      "Bash(tailscale set:*)",
      "Bash(tailscale down:*)",
      "Bash(tailscale login:*)",
      "Bash(netplan:*)",
      "Bash(nmcli:*)",
      "Bash(systemctl restart systemd-networkd:*)",
      "Bash(systemctl restart networking:*)",
      "Bash(systemctl restart NetworkManager:*)",
      "Bash(docker network create:*)",
      "Bash(docker network rm:*)",
      "Bash(docker network connect:*)",
      "Bash(docker network disconnect:*)",
      "Bash(docker network prune:*)",
      "Bash(docker run:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Edit(/etc/**)",
      "Write(/etc/**)",
      "Edit(//etc/**)",
      "Write(//etc/**)"
    ]
  }

# Zależności (odtwarzane przez npm install)
node_modules/

# Sekrety i lokalna konfiguracja — NIE commitować (jest .env.example)
.env
*.local

# Dane lokalne / baza SQLite (trzymana w wolumenie Dockera)
data/
*.db
*.db-shm
*.db-wal

# Narzędzia / stan lokalny
# UWAGA: .claude/settings.json jest CELOWO wersjonowany (uprawnienia i reguły
# izolacji sieci dla Claude Code na serwerze docelowym). Lokalny stan — nie.
.claude/settings.local.json
.claude/*.local.json
.DS_Store

# Paczki wdrożeniowe (budowane przez deploy/make-package.sh) i kopie zapasowe
/dist/
/backups/

# Logi
*.log
npm-debug.log*

# UWAGA: frontend/dist jest CELOWO wersjonowany (wdrożenie przez skopiowanie repo bez budowania)

# --- Aplikacja ---
JWT_SECRET=your_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
PORT=3000
DB_PATH=/app/data/wled_warehouse.db
NODE_ENV=production

# Strefa czasowa serwera (ważne dla zegara na panelach)
TZ=Europe/Warsaw

# Domyślny prefiks /24 do skanowania paneli (można zmienić w UI: Ustawienia).
# UWAGA: podsieć paneli to /23 — pełne pokrycie wymaga dwóch skanów:
# 192.168.188 oraz 192.168.189.
SCAN_SUBNET=192.168.188

# (opcjonalnie) Ogranicz CORS do konkretnych origin (lista po przecinku). Puste = odbija origin żądania.
# CORS_ORIGINS=http://192.168.188.11:3000

# --- Wdrożenie / sieć (docker-compose) ---
# Zmień przy migracji na inny serwer/sieć:
CONTAINER_NAME=wled_warehouse
APP_DIR=/opt/wled_warehouse
CONTAINER_IP=192.168.188.11
DOCKER_NETWORK=itx_vlan8_net

# Obraz kontenera. Puste/brak = node:20-alpine + npm install przy starcie (tryb dev).
# Wdrożenie z paczki ustawia tu obraz z prebudowanymi zależnościami (start offline).
# APP_IMAGE=wled-warehouse:1.0.0-20260911

# --- Dostęp do UI spoza VLAN-u paneli ---
# VLAN paneli nie ma routingu, więc UI udostępnia się publikując port aplikacji
# na hoście (osiągalny z sieci Rhenus i przez Tailscale). Włącza to nakładka
# docker-compose.access.yml — odkomentuj COMPOSE_FILE, żeby ją aktywować.
# Panele LED pozostają przy tym odcięte: nie powstaje żadna trasa do VLAN-u paneli.
#
# Działa TYLKO gdy 'docker compose' uruchamiasz z katalogu projektu
# (cd /opt/wled_warehouse), a nie przez --project-directory.
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.access.yml
# HOST_BIND=0.0.0.0
# HOST_PORT=3000
# ACCESS_NETWORK=wled_warehouse_access

# --- Aplikacja ---
JWT_SECRET=your_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
PORT=3000
DB_PATH=/app/data/wled_warehouse.db
NODE_ENV=production

# Strefa czasowa serwera (ważne dla zegara na panelach)
TZ=Europe/Warsaw

# Domyślny prefiks podsieci do skanowania paneli (można zmienić w UI: Ustawienia)
SCAN_SUBNET=192.168.200

# (opcjonalnie) Ogranicz CORS do konkretnych origin (lista po przecinku). Puste = odbija origin żądania.
# CORS_ORIGINS=http://192.168.200.11:3000

# --- Wdrożenie / sieć (docker-compose) ---
# Zmień przy migracji na inny serwer/sieć:
CONTAINER_NAME=wled_warehouse
APP_DIR=/opt/wled_warehouse
CONTAINER_IP=192.168.200.11
DOCKER_NETWORK=fleet-manager_vlan200_net
